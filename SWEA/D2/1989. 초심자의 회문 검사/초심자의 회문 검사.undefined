T = int(input())

for tc in range(1, T+1):
    char = input()

    if len(char) % 2:
        left_char = char[:len(char)//2]
        right_char = char[len(char)//2+1:]
    else:
        left_char = char[:len(char)//2]
        right_char = char[len(char)//2:]

    right_char = right_char[::-1]

    if left_char == right_char:
        ans = 1
    else:
        ans = 0

    print(f"#{tc} {ans}")