T = int(input())

for tc in range(1, T+1):
    N = int(input())
    price = list(map(int, input().split()))

    sale_sum = 0
    max_sale = 0

    for i in range(N-1, -1, -1):
        if price[i] >= max_sale:
            max_sale = price[i]
        elif price[i] < max_sale:
            sale_sum += max_sale - price[i]

    print(f"#{tc} {sale_sum}")