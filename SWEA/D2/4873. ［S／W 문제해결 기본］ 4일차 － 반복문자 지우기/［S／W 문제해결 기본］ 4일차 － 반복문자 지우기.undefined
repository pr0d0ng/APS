T = int(input())

for tc in range(1, T+1):
    string = input()
    string_len = len(string)

    top = -1
    stack = [0] * string_len

    for s in string:
        top += 1
        if s == stack[top-1]:
            top -= 1
            stack[top] = 0
            top -= 1
        else:
            stack[top] = s

    stack_len = len(stack) - stack.count(0)

    print(f"#{tc} {stack_len}")