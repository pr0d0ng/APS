T = int(input())

for tc in range(1, T+1):
    testcase, char_num = input().split()
    arr = input().split()

    num_map = {
        'ZRO': 0, 'ONE': 1, 'TWO': 2, 'THR': 3, 'FOR': 4,
        'FIV': 5, 'SIX': 6, 'SVN': 7, 'EGT': 8, 'NIN': 9
    }

    num_list = ['ZRO', 'ONE', 'TWO', 'THR', 'FOR', 'FIV', 'SIX', 'SVN', 'EGT', 'NIN']

    int_arr = [num_map[char] for char in arr]

    int_arr.sort()

    sorted_arr = [num_list[num] for num in int_arr]

    print(f"{testcase}{chr(10)}{' '.join(sorted_arr)}")