from collections import defaultdict

T = int(input())

for tc in range(1, T+1):
    str1 = input()
    str2 = input()

    str1 = list(set(str1))

    num_dict = defaultdict(int)

    for s in str1:
        for c in str2:
            if s == c:
                num_dict[s] += 1

    print(f"#{tc} {num_dict[max(num_dict, key=num_dict.get)]}")