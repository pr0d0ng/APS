from collections import defaultdict

T = int(input())

for tc in range(1, T+1):
    N = int(input())
    cards = input()
    card_dict = defaultdict(int)

    for card in cards:
        card_dict[int(card)] += 1

    max_card = max(card_dict, key=lambda x: (card_dict[x], x))

    print(f"#{tc} {max_card} {card_dict[max_card]}")