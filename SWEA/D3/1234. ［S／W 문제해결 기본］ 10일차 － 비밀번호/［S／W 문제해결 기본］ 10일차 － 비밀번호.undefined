T = 10

for tc in range(1, T+1):
    N, string = input().split()
    N = int(N)

    top = -1
    stack = ['#'] * N

    for s in string:
        top += 1
        if s == stack[top - 1]:
            top -= 1
            stack[top] = '#'
            top -= 1
        else:
            stack[top] = s

    tmp = [x for x in stack if x != '#']
    ans = ''.join(tmp)
    print(f"#{tc} {ans}")