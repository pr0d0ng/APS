T = int(input())

for tc in range(1, T+1):
    str1 = input()
    str2 = input()
    N = len(str1)
    M = len(str2)
    flag = 0

    for i in range(M-N+1):
        join_str2 = ''
        for j in range(i, i+N):
            join_str2 += str2[j]

        if str1 == join_str2:
            flag = 1
            break

    print(f"#{tc} {flag}")