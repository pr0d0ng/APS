T = int(input())

for tc in range(1, T+1):
    A, B, C = map(int, input().split())

    cnt = 0
    while A >= B or B >= C:
        if A >= B:
            A -= 1
            cnt += 1

        if B >= C:
            B -= 1
            cnt += 1

        if A == 0 or B == 0:
            cnt = -1
            break

    print(f"#{tc} {cnt}")