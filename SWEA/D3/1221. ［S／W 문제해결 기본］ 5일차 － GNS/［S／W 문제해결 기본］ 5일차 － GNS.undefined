T = int(input())

for tc in range(1, T+1):
    testcase, char_num = input().split()
    arr = list(input().split())

    for char in arr:
        if char == 'ZRO':
            arr[arr.index(char)] = 0
        elif char == 'ONE':
            arr[arr.index(char)] = 1
        elif char == 'TWO':
            arr[arr.index(char)] = 2
        elif char == 'THR':
            arr[arr.index(char)] = 3
        elif char == 'FOR':
            arr[arr.index(char)] = 4
        elif char == 'FIV':
            arr[arr.index(char)] = 5
        elif char == 'SIX':
            arr[arr.index(char)] = 6
        elif char == 'SVN':
            arr[arr.index(char)] = 7
        elif char == 'EGT':
            arr[arr.index(char)] = 8
        elif char == 'NIN':
            arr[arr.index(char)] = 9

    sorted_arr = sorted(arr)

    for num in sorted_arr:
        if num == 0:
            sorted_arr[sorted_arr.index(num)] = 'ZRO'
        if num == 1:
            sorted_arr[sorted_arr.index(num)] = 'ONE'
        if num == 2:
            sorted_arr[sorted_arr.index(num)] = 'TWO'
        if num == 3:
            sorted_arr[sorted_arr.index(num)] = 'THR'
        if num == 4:
            sorted_arr[sorted_arr.index(num)] = 'FOR'
        if num == 5:
            sorted_arr[sorted_arr.index(num)] = 'FIV'
        if num == 6:
            sorted_arr[sorted_arr.index(num)] = 'SIX'
        if num == 7:
            sorted_arr[sorted_arr.index(num)] = 'SVN'
        if num == 8:
            sorted_arr[sorted_arr.index(num)] = 'EGT'
        if num == 9:
            sorted_arr[sorted_arr.index(num)] = 'NIN'

    crlf = '\n'

    print(f"#{tc}{crlf}{' '.join(sorted_arr)}")