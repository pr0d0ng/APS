T = 10

for tc in range(1, T+1):
    str_len = int(input())
    string = input()

    flag = 1
    top = -1
    stack = [0] * str_len
    pair = {')': '(',
            ']': '[',
            '}': '{',
            '>': '<'}

    for s in string:
        if s in '([{<':
            top += 1
            stack[top] = s
        elif s in '>}])':
            if top == -1:
                flag = 0
                break
            else:
                top -= 1
                tmp = stack[top + 1]
                if pair[s] != tmp:
                    flag = 0
                    break

    if top != -1:
        flag = 0

    print(f"#{tc} {flag}")